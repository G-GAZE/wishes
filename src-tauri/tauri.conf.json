{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wishes",
  "version": "../package.json",
  "identifier": "com.gaze.wishes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wishes 众愿",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../data/": "./data"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"]
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "embedBootstrapper"
      }
    }
  }
}
